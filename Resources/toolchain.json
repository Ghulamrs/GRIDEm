    "cdb": {
      "name": "cdb",
      "description": "Microsoft's console debugger (Debugging Tools for Windows / the Windows SDK): debugs the Windows programs through their PDB. GRIDE drives it on a pseudo-console.",
      "role": "debugger",
      "languages": [],
      "targets": ["x86_64-windows"],
      "exe": "cdb.exe",
      "aliases": ["cdb"],
      "words": [],
      "lookup": { "env": "RIDE_CDB", "installDir": "", "dirs": ["%ProgramFiles(x86)%\\Windows Kits\\10\\Debuggers\\x64", "%ProgramFiles%\\Windows Kits\\10\\Debuggers\\x64"], "path": true, "vcvars": false, "description": "$RIDE_CDB, the Windows SDK's Debuggers\\x64, PATH" },
      "version": { "args": "-version", "description": "" },
      "outputEncoding": "oem",
      "diagnostics": "none",
      "environment": { "_NT_SYMBOL_PATH": "where cdb looks for symbols; GRIDE gives -y" },
      "session": {
        "description": "cdb on a pseudo-console (console: true - RIDE's startOnConsole; cdb flushes its prompt only to a console, and the console's escape sequences and echoes are taken out as it is read): source lines with .lines -e, l+t and l+s so a step lands on a statement, n 10 for decimal, Shalimar's runtime helpers stepped over; the marker printed in pieces so the echo of the command is not the marker; after every move .lastevent says whether the program ended and ln where it stands",
        "dialect": "cdb",
        "console": true,
        "preamble": [".lines -e", "l+t", "l+s", "n 10", ".step_filter \"*!shm_*;*!shm::*\""],
        "marker": "<<gride-done>>",
        "markerCommand": ".printf \"<<gride%cdone>>\\n\", 0x2d",
        "commands": {
          "break": "bp `$(File):$(Line)`", "clearBreakpoints": "bc *", "run": "g", "continue": "g", "stepOver": "p", "stepInto": "t", "stepOut": "gu",
          "afterMove": ".lastevent", "where": "ln", "runToLine": "bp `$(File):$(Line)`",
          "locals": "dv /t /V", "evaluate": "?? $(Expr)", "address": "?? &($(Expr))", "type": "?? $(Expr)", "set": "?? $(Name) = $(Value)",
          "frames": "k", "frame": ".frame $(N)", "registers": "r", "memory": "db $(Address) L$(Count)", "quit": "q"
        }
      },
      "archFlag": "",
      "includeFlag": "",
      "defineFlag": "",
      "installIncludeDirs": [],
      "languageFlags": {},
      "configFlags": { "Debug": "", "Release": "" },
      "configFlagsByTarget": {},
      "asmSyntaxFlags": { "codeview": "", "assemblerNamed": "" },
      "operations": {
        "debug": { "description": "start the program under cdb with its symbols beside it", "args": "-y \"$(OutDir)\" \"$(Program)\"", "output": "", "shown": "$(Program)", "arguments": { "-y": "the symbol path (the output folder, where the PDB is)" } }
      }
    },
