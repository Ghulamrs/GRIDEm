  "libraries": {
    "description": "The runtime libraries, as named entries: kind says what each is (runtime, printf, shalimarRuntime, hostCrt); target the arch it belongs to; directory the installation-relative directory holding the files (looked for under the tool folder, beside GRIDE.exe and the installation, in that order; directoryEnv names it outright) and marker the file that proves the directory is the right one; files names the library per configuration (a space-separated list where the link takes several); aliases are the names a project file may use for it, each read as the configuration's file ('*' matches any ending); assemblyDirectories / assemblyDirectoryEnv are where the runtime's assembly is, per configuration, for the emulator; when says when the library is linked: always, shalimar (a Shalimar program), printf (a program calling printf), never.",
    "rts6x": {
      "name": "RTS6x",
      "description": "RIDE's C runtime for the C6747: rts6x.lib built at -O2 for a Release build, rts6xd.lib at -O0 with _DEBUG for a Debug build. A project naming libc.a, rts6740*, rts6747.lib, rts6x.lib or rts6xd.lib gets the configuration's one.",
      "kind": "runtime",
      "target": "tms6747",
      "directory": "lib\\rts6x-tms6747",
      "directoryEnv": "RTS6X",
      "marker": "rts6x.lib",
      "files": { "Debug": "rts6xd.lib", "Release": "rts6x.lib" },
      "aliases": ["libc.a", "rts6740*", "rts6747.lib", "rts6x.lib", "rts6xd.lib"],
      "when": "always"
    },
    "printf6x": {
      "name": "printf6x",
      "description": "RTS6x's printf family in its own library, beside rts6x.lib; linked when a project names it.",
      "kind": "printf",
      "target": "tms6747",
      "directory": "lib\\rts6x-tms6747",
      "directoryEnv": "RTS6X",
      "marker": "printf6x.lib",
      "files": { "Debug": "printf6xd.lib", "Release": "printf6x.lib" },
      "aliases": ["printf6x.lib", "printf6xd.lib"],
      "when": "printf"
    },
    "shmrt6x": {
      "name": "shmrt6x",
      "description": "The Shalimar runtime for the C6747: as a library beside RTS6x (shmrt6x.lib, shmrt6xd.lib for a Debug build) linked before the C runtime it calls into, and as assembly directories the emulator takes (lib\\shmrt-tms6747, -debug for Debug).",
      "kind": "shalimarRuntime",
      "target": "tms6747",
      "directory": "lib\\rts6x-tms6747",
      "directoryEnv": "RTS6X",
      "marker": "shmrt6x.lib",
      "files": { "Debug": "shmrt6xd.lib", "Release": "shmrt6x.lib" },
      "aliases": ["shmrt6x.lib", "shmrt6xd.lib"],
      "assemblyDirectories": { "Debug": "lib\\shmrt-tms6747-debug", "Release": "lib\\shmrt-tms6747" },
      "assemblyDirectoryEnv": { "Debug": "SHMRT6747D", "Release": "SHMRT6747" },
      "when": "shalimar"
    },
    "shmrtWindows": {
      "name": "the Shalimar runtime (Windows)",
      "description": "The Shalimar runtime for x86_64-windows, which RIDE's shalimar links itself and GRIDE links with the objects: shmrt-x86_64-windows.lib, and shmrt-x86_64-windows-debug.lib for a Debug build - the runtime with the session in it (SHM_DEBUG=1). Linked first, before the C runtime it calls into.",
      "kind": "shalimarRuntime",
      "target": "x86_64-windows",
      "directory": "lib",
      "directoryEnv": "",
      "marker": "shmrt-x86_64-windows.lib",
      "files": { "Debug": "shmrt-x86_64-windows-debug.lib", "Release": "shmrt-x86_64-windows.lib" },
      "aliases": ["shmrt-x86_64-windows.lib", "shmrt-x86_64-windows-debug.lib"],
      "when": "shalimar"
    },
    "hostCrt": {
      "name": "the Windows CRT",
      "description": "The C runtime the Windows link names, since the compilers' objects carry no /DEFAULTLIB: the static CRT of the configuration, kernel32 and the legacy stdio definitions. link finds them through LIB (vcvars64.bat). cl's objects do name theirs (/MT, /MTd, /MD ...): a link of cl's objects alone adds none.",
      "kind": "hostCrt",
      "target": "x86_64-windows",
      "directory": "",
      "directoryEnv": "LIB",
      "marker": "",
      "files": { "Debug": "libcmtd.lib libucrtd.lib libvcruntimed.lib kernel32.lib legacy_stdio_definitions.lib", "Release": "libcmt.lib libucrt.lib libvcruntime.lib kernel32.lib legacy_stdio_definitions.lib" },
      "aliases": [],
      "when": "always"
    }
  },

  "linkerCommandFiles": {
    "description": "Linker command files GRIDE writes into the build directory when the project brings none: name is the file name, lines its text.",
    "ti-link": {
      "name": "ti-link.cmd",
      "description": "RIDE's own command file for lnk6x: one flat memory for the C6747 with every section the compilers and the runtime write placed in it (--rom_model, a 16 KB stack, a 1 MB heap).",
      "lines": [
        "/* one flat memory for the C6747 and every section in it - written by GRIDE, as RIDE writes it */",
        "--rom_model",
        "--stack_size=0x4000",
        "--heap_size=0x100000",
        "MEMORY",
        "{",
        "    RAM : origin = 0xC0000000, length = 0x04000000",
        "}",
        "SECTIONS",
        "{",
        "    .text        > RAM",
        "    .const       > RAM",
        "    .data        > RAM",
        "    .bss         > RAM",
        "    .far         > RAM",
        "    .fardata     > RAM",
        "    .neardata    > RAM",
        "    .rodata      > RAM",
        "    .cinit       > RAM",
        "    .init_array  > RAM",
        "    .switch      > RAM",
        "    .cio         > RAM",
        "    .stack       > RAM",
        "    .sysmem      > RAM",
        "    .vm6747.eh   > RAM",
        "}"
      ]
    }
  }
}
