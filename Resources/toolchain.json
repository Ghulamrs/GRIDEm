      "version": { "args": "--version", "description": "prints the banner line with the version" },
      "outputEncoding": "utf-8",
      "diagnostics": "shalimar",
      "environment": {
        "SHALIMAR_AS": "the assembler shalimar runs for a build without -S",
        "SHALIMAR_LD": "the linker shalimar runs for a build without -S",
        "SHM_DEBUG": "1 starts the debugging session protocol (#file / #ready / #stop / #exit on stderr)"
      },
      "session": {
        "description": "the Shalimar session, RIDE's shalimar::Session: a Debug build stops itself. The compiler calls shm_line before every statement, and the debugging runtime (--debug on a host; shmrt6xd.lib on tms6747), started with SHM_DEBUG=1, talks on its standard error while the program prints on its standard output: a protocol line for every source (file <unit> <leaf>), one when it is ready, one at every stop (stop <unit> <line> <depth>), one to a where (at <unit> <line> <depth>) and one at the end (exit <status>). The commands are a letter each: b and d take a unit and a line, c / n / s / o move, w asks where, q quits. afterReady names the command sent first: the shipped runtime reads and discards the first line after its ready line, and a where costs nothing either way. On tms6747 the .out runs under the simulator's session operation where no emulator debugs it.",
        "dialect": "shalimar",
        "environment": { "SHM_DEBUG": "1" },
        "protocol": { "file": "#file", "ready": "#ready", "stop": "#stop", "at": "#at", "exit": "#exit" },
        "afterReady": "where",
        "commands": {
          "where": "w", "break": "b $(Unit) $(Line)", "clearBreakpoint": "d $(Unit) $(Line)",
          "run": "c", "continue": "c", "stepOver": "n", "stepInto": "s", "stepOut": "o", "quit": "q"
        }
      },
      "archFlag": "--target=$(Arch)",
      "includeFlag": "",
      "defineFlag": "",
      "installIncludeDirs": [],
      "languageFlags": {},
      "configFlags": { "Debug": "--debug -g", "Release": "" },
      "configFlagsByTarget": { "tms6747": { "Debug": "-g", "Release": "" } },
      "options": ["shc.opt", "shc.debugrt", "shc.g", "shc.search", "general.nologo"],
      "asmSyntaxFlags": { "codeview": "", "assemblerNamed": "" },
      "operations": {
        "compileToAssembly": {
          "description": "Shalimar to assembly: a program is one compilation - the file with main() and the files it calls into, which shalimar compiles as one - so every file of the build goes in one command ($(Sources)) and one assembly file comes out, named after the program",
          "args": "-S $(Sources) -o \"$(AsmFile)\" $(ArchFlag) $(ConfigFlags) $(AsmSyntaxFlag) $(IncludeFlags) $(DefineFlags) $(CompileFlags)",
          "output": "$(AsmFile)",
          "shown": "-S $(Source) $(ArchFlag) $(ConfigFlags)",
          "arguments": {
            "-S": "stop after the assembly",
            "-o": "the assembly file to write",
            "--target=": "the target: x86_64-windows, x86_64-linux, arm64-darwin or tms6747",
            "--debug": "the debugging runtime (Debug on a host target; tms6747 takes it from the configuration's shmrt6xd.lib)",
            "-g": "line table and debug information (Debug)",
            "--no-search": "no search of the runtime's library (Compiler Options)",
            "-nologo": "no banner line"
          }
