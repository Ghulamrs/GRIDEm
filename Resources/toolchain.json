// toolchain.json (GRIDEm, macOS) - the same toolchain definition GRIDEd reads, with the Mac as the
// host: arm64-darwin is "host": true, "run": "program" (the program itself) and x86_64-windows is not
// a host here ("run": "none"). Nothing else differs from GRIDEd's file - Tools/toolchain-diff.py
// checks that. The shipped copy lives in GRIDEm.app/Contents/Resources; the user's copy
// (~/Library/Application Support/GRIDE/toolchain.json, or toolchain.user.json beside a portable
// GRIDEm.app) overrides it field by field. Program names keep GRIDEd's ".exe"; GRIDEm also tries
// each name without it. The reader takes // line comments; the format is in TOOLCHAIN-FORMAT.md.
{
  "format": 1,
  "description": "RIDE 5.17's toolchain as GRIDE drives it: c90, cpp11 and shalimar compile to assembly for four targets; masm and link (or clang and Microsoft's link.exe for a Debug build) make the Windows program, asm6x and lnk6x the TMS320C6747 program against RTS6x; sim6747 runs it, vm6747 emulates the assembly and debugs; cdb, gdb and lldb debug the host programs; c2s converts between C and Shalimar.",

  "installation": {
    "description": "Where the toolchain is installed. A tool whose lookup says installDir is looked for under <root>\\<binDir>; the root is Tools > Options > Projects > 'RIDE root or bin' when set, else each defaultRoots entry (environment variables expanded) that holds one of the markers in its binDir, else the folder of GRIDE.exe itself. includeDir and libDir are the installation's header directories the compilers are given (see each tool's installIncludeDirs).",
    "defaultRoots": ["%ProgramFiles%\\RIDE", "%ProgramFiles(x86)%\\RIDE", "%ProgramW6432%\\RIDE"],
    "binDir": "bin",
    "markers": ["c90.exe", "cpp11.exe"],
    "includeDir": "include",
    "libDir": "lib"
  },

  "ccs": {
    "description": "Reading Code Composer Studio 7.4 / 5.5 projects for the C6747, as RIDE reads them: definitionsDir holds TI's own option definitions (one TSV per compiler major version, keyed by it; CCS stores in .cproject only what differs from the definition's default, so an unstored option's meaning and an enumerated value's spelling come from here); the directory is looked for beside GRIDE.exe, above it, and under the installation. deviceFamily / deviceVariant / siliconVersion say which projects the toolchain builds (others are read, with a note saying why RIDE would refuse them); compilerDirs name the compiler directory under <CCS root>/tools/compiler per major version; tiRuntime maps TI's library index to the runtime a linker reads.",
    "definitionsDir": "lib\\ccs",
    "definitions": { "8": "options-ccs74-C6000_8.2.tsv", "7": "options-ccs55-C6000_7.4.tsv" },
    "deviceFamily": "C6000",
    "deviceVariant": "C674",
    "siliconVersion": "6740",
    "compilerDirs": { "8": "ti-cgt-c6000_", "7": "c6000_" },
    "tiRuntime": { "index": "libc.a", "library": "rts6740_elf_eh.lib", "fallback": "rts6740_elf.lib" },
    "tiCompiler": {
      "description": "TI's C6000 compiler directory (the one with bin\\lnk6x), named under Tools > Options > Projects > RIDE Paths, else the newest one found as CCS's installer leaves them: under each of roots (environment variables expanded), at each of the layouts in under (a trailing * names any folder starting so; an empty entry is the root itself), a folder named as compilerDirs says; bin holds the linker, lib the runtime. A named directory makes a tms6747 build link against TI's runtime instead of RTS6x, as in RIDE.",
      "roots": ["%SystemDrive%\\ti"],
      "under": ["", "ccs*\\tools\\compiler", "ccs*\\ccs\\tools\\compiler"],
      "bin": "bin",
      "lib": "lib"
    }
  },

  "compilerOptions": {
    "description": "RIDE's Compiler Options (options.cpp): the table Tools > Options > Projects > Compiler Options and Project > Properties draw, one entry per option in the order each tab shows them, keyed by id (<tool word>.<option>; general.* serve several compilers). tab, label and hint are the dialog's. control is check (the value is 1 or 0), choice (one of choices; the first is the compiler's own default and is never written) or text (';' between the entries). default is one value, or one per configuration as { Debug, Release }. What an option becomes: flagOn / flagOff for a check (written when the value is 1 / 0), flag for a choice ($(Value) filled in; silent names the choice that writes nothing - the first when absent), flagEach for a text list ($(Item) filled in once per entry, an entry holding a space quoted), environment names a variable the compiler is given instead of a flag (its value 1, or empty). needs says when the option means something: lineTable (the compiler writes a line table for the target), emulated (the emulated target only), notEmulated - with unavailable the sentence said otherwise ($(Arch) filled in); an option that does not apply writes nothing. Each compiler's options field lists the ids it takes, in the order the flags are written; a compiler without one takes its configFlags.",
    "tabs": ["General", "C (c90)", "C++ (cpp11)", "Shalimar"],
    "options": {
      "general.nologo": { "tab": "General", "label": "Hide the compiler's banner (-nologo)", "control": "check", "default": "0", "flagOn": "-nologo", "hint": "c90, cpp11 and shalimar" },
      "general.jobs": { "tab": "General", "label": "Parallel jobs (-j)", "control": "choice", "choices": ["Auto", "1", "2", "4", "8"], "default": "Auto", "flag": "-j$(Value)", "silent": "Auto", "hint": "c90 and cpp11; Auto is serial below four files" },
      "general.time": { "tab": "General", "label": "Phase timings (-time)", "control": "check", "default": "0", "flagOn": "-time", "hint": "c90 and cpp11" },
      "c90.opt": { "tab": "C (c90)", "label": "Optimization", "control": "choice", "choices": ["-O0", "-O1", "-O2"], "default": { "Debug": "-O0", "Release": "-O2" }, "flag": "$(Value)", "silent": "-O0", "hint": "x86_64 targets only; -O2 is -O1 today" },
      "c90.g": { "tab": "C (c90)", "label": "Debug line table (-g)", "control": "check", "default": { "Debug": "1", "Release": "0" }, "flagOn": "-g", "needs": "lineTable", "unavailable": "no line table for $(Arch) (x86_64-linux and arm64-darwin have one)", "hint": "" },
      "c90.defines": { "tab": "C (c90)", "label": "Defines (-D)", "control": "text", "default": { "Debug": "_DEBUG=1", "Release": "NDEBUG=1" }, "flagEach": "-D$(Item)", "hint": "';' between them: NAME or NAME=value" },
      "c90.undefines": { "tab": "C (c90)", "label": "Undefines (-U)", "control": "text", "default": "", "flagEach": "-U$(Item)", "hint": "';' between them" },
      "cpp11.opt": { "tab": "C++ (cpp11)", "label": "Optimization", "control": "choice", "choices": ["-O0", "-O1", "-O2"], "default": { "Debug": "-O0", "Release": "-O2" }, "flag": "$(Value)", "silent": "-O0", "hint": "tms6747: -O1 schedules packets and keeps locals in registers, -O2 adds pipelining; x86_64: -O2 adds inlining" },
      "cpp11.g": { "tab": "C++ (cpp11)", "label": "Debug line table (-g)", "control": "check", "default": { "Debug": "1", "Release": "0" }, "flagOn": "-g", "needs": "lineTable", "unavailable": "no line table for $(Arch) (x86_64-linux and arm64-darwin have one)", "hint": "" },
      "cpp11.defines": { "tab": "C++ (cpp11)", "label": "Defines (-D)", "control": "text", "default": { "Debug": "_DEBUG=1", "Release": "NDEBUG=1" }, "flagEach": "-D$(Item)", "hint": "';' between them: NAME or NAME=value" },
      "cpp11.undefines": { "tab": "C++ (cpp11)", "label": "Undefines (-U)", "control": "text", "default": "", "flagEach": "-U$(Item)", "hint": "';' between them" },
      "cpp11.declines": { "tab": "C++ (cpp11)", "label": "Report what the optimizer declined (CPP11_DECLINES)", "control": "check", "default": "0", "environment": "CPP11_DECLINES", "hint": "one line on stderr per function or call not optimized" },
      "cpp11.compress": { "tab": "C++ (cpp11)", "label": "Compact 16-bit instructions (off: --no_compress)", "control": "check", "default": "1", "flagOff": "--no_compress", "needs": "emulated", "unavailable": "compact instructions are the C6000's; tms6747 only", "hint": "tms6747 only; the C674x runs them natively, and TI's cl6x writes them by default" },
      "shc.opt": { "tab": "Shalimar", "label": "Optimization", "control": "choice", "choices": ["-O0", "-O1", "-O2"], "default": "-O0", "flag": "$(Value)", "silent": "-O0", "hint": "x86_64 targets only; -O2 is -O1 today" },
      "shc.debugrt": { "tab": "Shalimar", "label": "Debug runtime (--debug)", "control": "check", "default": { "Debug": "1", "Release": "0" }, "flagOn": "--debug", "needs": "notEmulated", "unavailable": "tms6747 takes the Debug runtime from the configuration - a Debug build links shmrt6xd.lib", "hint": "" },
      "shc.g": { "tab": "Shalimar", "label": "Debug information (-g)", "control": "check", "default": { "Debug": "1", "Release": "0" }, "flagOn": "-g", "needs": "lineTable", "unavailable": "no line table for $(Arch) (x86_64-linux and arm64-darwin have one)", "hint": "DWARF on x86_64-linux and arm64-darwin, CodeView on x86_64-windows, .dwpsn on tms6747 (D1 to D5)" },
      "shc.search": { "tab": "Shalimar", "label": "Compile sibling .shl and .shm files", "control": "check", "default": "1", "flagOff": "--no-search", "hint": "off passes --no-search" }
    }
  },

  "visualStudio": {
    "description": "Where Visual Studio's tools are (cl, ml64, Microsoft's link.exe, clang) and the directories their environment needs, found without cmd.exe: vswhere names the newest installation (any edition, prerelease and Build Tools included), else the defaultRoots are tried; under the installation, msvcTools holds one folder per compiler version with hostBin, lib and include below it - the newest is taken, or the one msvcVersion names (\"14.44\" takes the newest 14.44.*, Visual Studio 2022's v143; a whole folder name takes that one; empty, or a version not there, the newest) for cl, link.exe, INCLUDE and LIB alike; llvmBin holds clang; the Windows SDK (windowsKits: the registry value, else the roots; the newest version folder) gives the libDirs and includeDirs, $(Version) filled in. environment names the variables set for a tool run: each entry's value is the list of directories joined with ';', followed by the variable's old value.",
    "msvcVersion": "",
    "vswhere": "%ProgramFiles(x86)%\\Microsoft Visual Studio\\Installer\\vswhere.exe",
    "vswhereArgs": "-latest -prerelease -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath",
    "defaultRoots": ["%ProgramFiles%\\Microsoft Visual Studio\\18", "%ProgramFiles%\\Microsoft Visual Studio\\2022", "%ProgramFiles(x86)%\\Microsoft Visual Studio\\2019", "%ProgramFiles(x86)%\\Microsoft Visual Studio\\2017"],
    "editions": ["Community", "Professional", "Enterprise", "BuildTools", "Preview"],
    "vcvars": "VC\\Auxiliary\\Build\\vcvars64.bat",
    "msvcTools": "VC\\Tools\\MSVC",
    "hostBin": "bin\\Hostx64\\x64",
    "lib": "lib\\x64",
    "include": "include",
    "llvmBin": "VC\\Tools\\Llvm\\x64\\bin",
    "windowsKits": {
      "registryKey": "SOFTWARE\\WOW6432Node\\Microsoft\\Microsoft SDKs\\Windows\\v10.0",
      "registryValue": "InstallationFolder",
      "roots": ["%ProgramFiles(x86)%\\Windows Kits\\10", "%ProgramFiles%\\Windows Kits\\10"],
      "versionsUnder": "Lib",
      "libDirs": ["Lib\\$(Version)\\ucrt\\x64", "Lib\\$(Version)\\um\\x64"],
      "includeDirs": ["Include\\$(Version)\\ucrt", "Include\\$(Version)\\um", "Include\\$(Version)\\shared"],
      "binDir": "bin\\$(Version)\\x64"
    },
    "environment": { "INCLUDE": "the compiler's headers: MSVC's include, the SDK's includeDirs", "LIB": "the linker's libraries: MSVC's lib, the SDK's libDirs", "PATH": "the tools: MSVC's hostBin, llvmBin, the SDK's binDir" }
  },

  "placeholders": {
    "description": "The names an argument template may use; GRIDE fills them in when a tool runs. A path placeholder is written without quotes, so a template quotes it where the tool wants quotes.",
    "$(Compiler)": "full path of the compiler chosen for the file",
    "$(Assembler)": "full path of the target's assembler (role assembler)",
    "$(Linker)": "full path of the target's linker (role linker)",
    "$(DebugAssembler)": "full path of the Debug build's assembler (role debugAssembler, the CodeView path on Windows)",
    "$(DebugLinker)": "full path of the Debug build's linker (role debugLinker)",
    "$(Simulator)": "full path of the simulator (role simulator)",
    "$(Emulator)": "full path of the emulator (role emulator)",
    "$(Debugger)": "full path of the debugger (role debugger)",
    "$(Runtime)": "a runtime library file named under Tools > Options > Toolchains (usually empty: the libraries section chooses)",
    "$(RuntimeDir)": "the target's runtime library directory (the runtime library's directory, found or named)",
    "$(ToolDir)": "the tool folder of Tools > Options > Toolchains",
    "$(Source)": "the source file being compiled, full path (the first one of a Shalimar program, which is compiled as one)",
    "$(Sources)": "every source of the compilation, each quoted: a Shalimar program's files, which shalimar compiles as one",
    "$(SourceDir)": "its folder",
    "$(Name)": "the object name chosen for the source (its stem, made unique within the build)",
    "$(AsmFile)": "the assembly file the compiler writes / the assembler reads",
    "$(AsmFiles)": "every assembly file of the build, each quoted",
    "$(ObjFile)": "the object file the assembler writes",
    "$(Objects)": "every object file of the build, each quoted",
    "$(Output)": "the program the linker writes, full path",
    "$(Program)": "the program to run or debug, full path (the .out on tms6747)",
    "$(ObjDir)": "the configuration's object folder",
    "$(OutDir)": "the configuration's output folder",
    "$(Arch)": "the target's arch word: x86_64-windows, x86_64-linux, arm64-darwin or tms6747",
    "$(ArchFlag)": "the target as the compiler spells it (its archFlag with $(Arch) filled in)",
    "$(ConfigFlags)": "the compiler's flags for the configuration (its configFlags, or Compiler Options when set)",
    "$(AsmSyntaxFlag)": "the compiler's assembler-syntax flag for this build (asmSyntaxFlags)",
    "$(LangFlags)": "the compiler's language switch for the file (languageFlags: cl's /TC or /TP ...)",
    "$(IncludeFlags)": "the include directories, each with the compiler's includeFlag, quoted",
    "$(DefineFlags)": "the configuration's defines, each with the compiler's defineFlag",
    "$(LibDirFlags)": "the library directories, each with the target's libraryDirFlag",
    "$(LibFlags)": "the project's libraries, each with the target's libraryFlag",
    "$(CrtLibs)": "the host C runtime libraries of the configuration (the hostCrt library entry)",
    "$(Optimise)": "the configuration's optimisation word (O0 .. O3)",
    "$(CompileFlags)": "the configuration's extra compile flags (Project > Properties)",
    "$(LinkFlags)": "the configuration's extra link flags",
    "$(LinkerCmd)": "the linker command file (the project's, or the written one of linkerCommandFiles)",
    "$(Config)": "Debug or Release",
    "$(Target)": "the IDE's target name",
    "$(ProjectDir)": "the project folder",
    "$(ProjectName)": "the project name",
    "$(WorkspaceDir)": "the workspace folder",
    "$(Arguments)": "the program's command line arguments, each quoted (run and emulate)",
    "$(ShalimarRuntimeDir)": "the Shalimar runtime's assembly directory, quoted, for a Shalimar program on the emulator; empty otherwise"
  },

  "targets": {
    "description": "The four targets, keyed by the arch word c90, cpp11 and shalimar take. ideTarget names the IDE's target; host says the programs run on this machine; emulated says the program runs on the emulator or simulator; debugInfo is what a Debug build carries (codeview, dwarf, dwpsn, or empty for none); roles names, per role, the tool id that plays it for this target (nativeAssembler / nativeLinker are the vendor's tools offered when the project's own fail); runtime names the libraries entry linked as the C runtime; run and debug say how a program is started here: program (the program itself), simulator (the simulator's simulate / debug operations), debugger (the debugger's debug operation), none (the target only reaches assembly on this machine).",
    "x86_64-windows": {
      "ideTarget": "Windows",
      "name": "x86_64-windows",
      "description": "Windows on x86-64: the programs are native and run here; a Debug build carries CodeView through clang and link.exe /DEBUG, a Release build goes through masm and link.",
      "host": false,
      "emulated": false,
      "debugInfo": "codeview",
      "assemblyExtension": ".s",
      "objectExtension": ".obj",
      "programExtension": ".exe",
      "emulatedProgramExtension": "",
      "libraryDirFlag": "/LIBPATH:",
      "libraryFlag": "",
      "roles": { "cCompiler": "c90", "cppCompiler": "cpp11", "shalimarCompiler": "shalimar", "hostCompiler": "cl", "assembler": "masm", "linker": "link", "debugAssembler": "clang", "debugLinker": "mslink", "nativeAssembler": "ml64", "nativeLinker": "mslink", "debugger": "cdb", "fallbackDebugger": "lldbWindows" },
      "runtime": "hostCrt",
      "run": "none",
      "debug": "debugger",
      "shownRun": "$(Compiler) $(Source) -o ride-run $(ConfigFlags) $(AsmSyntaxFlag) $(IncludeFlags)"
    },
    "x86_64-linux": {
      "ideTarget": "Linux",
      "name": "x86_64-linux",
      "description": "Linux on x86-64: the compilers reach assembly here; assembling, linking and running need a Linux machine (as, cc, gdb).",
      "host": false,
      "emulated": false,
      "debugInfo": "dwarf",
      "assemblyExtension": ".s",
      "objectExtension": ".o",
      "programExtension": "",
      "emulatedProgramExtension": "",
      "libraryDirFlag": "-L",
      "libraryFlag": "-l",
      "roles": { "cCompiler": "c90", "cppCompiler": "cpp11", "shalimarCompiler": "shalimar", "hostCompiler": "hostCxx", "assembler": "as", "linker": "cc", "debugger": "gdb" },
      "runtime": "",
      "run": "none",
      "debug": "debugger",
      "shownRun": "$(Compiler) $(Source) -o ride-run $(ConfigFlags) $(AsmSyntaxFlag) $(IncludeFlags)"
    },
    "arm64-darwin": {
      "ideTarget": "macOS",
      "name": "arm64-darwin",
      "description": "macOS on Apple silicon: the compilers reach assembly here; assembling, linking and running need a Mac (as, cc, lldb).",
      "host": true,
      "emulated": false,
      "debugInfo": "dwarf",
      "assemblyExtension": ".s",
      "objectExtension": ".o",
      "programExtension": "",
      "emulatedProgramExtension": "",
      "libraryDirFlag": "-L",
      "libraryFlag": "-l",
      "roles": { "cCompiler": "c90", "cppCompiler": "cpp11", "shalimarCompiler": "shalimar", "hostCompiler": "hostCxx", "assembler": "as", "linker": "cc", "debugger": "lldb" },
      "runtime": "",
      "run": "program",
      "debug": "debugger",
      "shownRun": "$(Compiler) $(Source) -o ride-run $(ConfigFlags) $(AsmSyntaxFlag) $(IncludeFlags)"
    },
    "tms6747": {
      "ideTarget": "TMS320C6747",
      "name": "tms6747",
      "description": "The TMS320C6747 DSP: the compilers write C6000 assembly, asm6x and lnk6x make the .out against RTS6x, sim6747 runs it, vm6747 runs the assembly straight and is the debugger (through sim6747 --run --debug).",
      "host": false,
      "emulated": true,
      "debugInfo": "dwpsn",
      "assemblyExtension": ".s",
      "objectExtension": ".obj",
      "programExtension": ".out",
      "emulatedProgramExtension": ".vm",
      "libraryDirFlag": "-i ",
      "libraryFlag": "-l ",
      "roles": { "cCompiler": "c90", "cppCompiler": "cpp11", "shalimarCompiler": "shalimar", "assembler": "asm6x", "linker": "lnk6x", "nativeLinker": "tilnk6x", "simulator": "sim6747", "emulator": "vm6747", "debugger": "vm6747" },
      "runtime": "rts6x",
      "linkerCommandFile": "ti-link",
      "run": "simulator",
      "debug": "simulator",
      "shownRun": "$(Compiler) -S $(ArchFlag) $(Source) -o ride-run.s $(ConfigFlags) $(IncludeFlags) && $(Assembler) && $(Linker) -o ride-run.out && $(Simulator) --run ride-run.out",
      "shownEmulate": "$(Compiler) -S $(ArchFlag) $(Source) -o ride-run.s $(ConfigFlags) $(IncludeFlags) && $(Emulator) ride-run.s $(ShalimarRuntimeDir)"
    }
  },

  "tools": {
    "description": "Every program, keyed by a stable id the code uses. name is what GRIDE prints; role classifies it (cCompiler, cppCompiler, shalimarCompiler, hostCompiler, hostCxx, assembler, linker, debugAssembler, debugLinker, simulator, emulator, debugger, converter); languages (C, C++, Shalimar) and targets (arch words) say what it serves; exe is the program's file name and aliases the other names tried in order; words are what a project file may call it; lookup says where it is looked for, in order: the environment variable env when set, Tools > Options' tool folder, beside GRIDE.exe, the installation's installDir, then PATH when path is true (vcvars true: Visual Studio's, reached through vcvars64.bat); version is the query that prints its version; outputEncoding is how its output is read (utf-8, or oem for the console's code page); diagnostics names the shape of its error lines (gnu, msvc, shalimar, masm, ti, none); environment lists the variables the tool itself reads; archFlag spells the target ($(Arch) filled in; empty for a tool that builds for the machine it is on); includeFlag / defineFlag are its -I / -D spellings (empty: the tool takes none); installIncludeDirs names the installation directories it is given as includes (include, lib); languageFlags the switch per language; configFlags the flags per configuration, configFlagsByTarget the exceptions per arch - both stand in where the tool lists no options; options names the compilerOptions entries the tool takes, in the order their flags are written (RIDE's Compiler Options then make its configuration flags); session, for a tool that debugs, says how it is driven on its standard input: dialect (gdb, lldb, cdb - the shapes its answers are read in), preamble (the commands sent at start), marker and markerCommand (what is asked for after every command, and the text that then ends the answer), commands (the spelling of each thing the IDE asks: break, clearBreakpoints, run, continue, stepOver, stepInto, stepOut, runToLine, args, locals, evaluate, address, type, set, frames, frame, registers, memory, afterMove, where, quit - with $(File), $(Line), $(Expr), $(Name), $(Value), $(N), $(Count), $(Address) filled in); like names a tool whose session this one starts from, its own fields over it; asmSyntaxFlags.codeview is added to a Debug build whose target carries CodeView, asmSyntaxFlags.assemblerNamed when an assembler is named for a host build; operations hold the argument templates, one per thing the tool does, each with the meaning of every argument.",
    "c90": {
      "name": "c90",
      "description": "RIDE's ISO C 90 compiler. Compiles C to assembly for every target (-S); without -S it assembles and links itself through C90_AS and C90_LD (Visual Studio's ml64 and link.exe on Windows, or the masm and link beside it).",
      "role": "cCompiler",
      "languages": ["C"],
      "targets": ["x86_64-windows", "x86_64-linux", "arm64-darwin", "tms6747"],
      "exe": "c90.exe",
      "aliases": ["c90", "cc1.exe", "cc1"],
      "words": ["c90", "cc1"],
      "lookup": { "env": "C90", "installDir": "bin", "path": true, "vcvars": false, "description": "$C90 names it outright; else the tool folder, beside GRIDE.exe, the installation's bin, PATH" },
      "version": { "args": "--version", "description": "prints the banner line with the version" },
      "outputEncoding": "utf-8",
      "diagnostics": "gnu",
      "environment": {
        "C90_AS": "the assembler c90 runs for a build without -S (ml64 by default)",
        "C90_LD": "the linker c90 runs for a build without -S (link.exe by default)"
      },
      "archFlag": "-arch $(Arch)",
      "includeFlag": "-I",
      "defineFlag": "-D",
      "installIncludeDirs": ["lib"],
      "languageFlags": {},
      "configFlags": { "Debug": "-g -D_DEBUG=1", "Release": "-O2 -DNDEBUG=1" },
      "configFlagsByTarget": {},
      "options": ["c90.opt", "c90.g", "c90.defines", "c90.undefines", "general.nologo", "general.jobs", "general.time"],
      "asmSyntaxFlags": { "codeview": "-masm=gnu", "assemblerNamed": "" },
      "operations": {
        "compileToAssembly": {
          "description": "C to assembly, the step every GRIDE build runs",
          "args": "-S \"$(Source)\" -o \"$(AsmFile)\" $(ArchFlag) $(ConfigFlags) $(AsmSyntaxFlag) $(IncludeFlags) $(DefineFlags) $(CompileFlags)",
          "output": "$(AsmFile)",
          "shown": "-S $(Source) $(ArchFlag) $(ConfigFlags) $(AsmSyntaxFlag) $(IncludeFlags)",
          "arguments": {
            "-S": "stop after the assembly",
            "-o": "the assembly file to write",
            "-arch": "the target: x86_64-windows, x86_64-linux, arm64-darwin or tms6747",
            "-g": "line table and debug information (Debug)",
            "-O2": "optimise (Release)",
            "-D": "define a macro: -D_DEBUG=1 / -DNDEBUG=1 by configuration, the project's own after",
            "-masm=gnu": "write the GNU spelling of x86-64 assembly (a Debug build's CodeView path)",
            "-I": "a header directory",
            "-nologo": "no banner line"
          }
        },
        "compileToObject": {
          "description": "C to an object through the compiler's own assembler (a project of several compilers)",
          "args": "-c \"$(Source)\" -o \"$(ObjFile)\" $(ArchFlag) $(ConfigFlags) $(AsmSyntaxFlag) $(IncludeFlags) $(DefineFlags) $(CompileFlags)",
          "output": "$(ObjFile)",
          "arguments": { "-c": "stop after the object", "-o": "the object file to write" }
        },
        "compileAndLink": {
          "description": "C to a program: the compiler assembles and links itself (C90_AS, C90_LD)",
          "args": "\"$(Source)\" -o \"$(Program)\" $(ConfigFlags) $(AsmSyntaxFlag) $(IncludeFlags) $(DefineFlags) $(CompileFlags)",
          "output": "$(Program)",
          "shown": "$(Source) -o ride-run $(ConfigFlags) $(AsmSyntaxFlag) $(IncludeFlags)",
          "arguments": { "-o": "the program to write" }
        }
      }
    },
    "cpp11": {
      "name": "cpp11",
