// primes.shl
// The program: the primes below 50, their
// count, and the twin pairs among them.
// isprime and gcd are in numbers.shl.

fun <> = main() {
  count : 0
  n : 2
  while n < 50 {
    if isprime(n) = 1 {
      count : count + 1
      if isprime(n + 2) = 1 {
        ? "twins" n n + 2
      }
    }
    n : n + 1
  }
  ? "primes below 50:" count
  ? "gcd 1071 462:" gcd(1071, 462)
}
