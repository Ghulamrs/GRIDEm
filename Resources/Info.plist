<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  GRIDEm.app's Info.plist: the bundle, the minimum macOS, and the files Finder hands to GRIDEm.
  Workspaces, projects and Visual Studio files are opened as a workspace by GRAppDelegate
